{
  "name": "@musterd/whiteboard",
  "version": "0.1.0",
  "description": "A shared whiteboard for a person and an agent to brainstorm on. The person draws in Squig's editor; the agent draws and reads through MCP tools; every item is labelled with who put it there.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musterd-io/whiteboard.git"
  },
  "homepage": "https://github.com/musterd-io/whiteboard#readme",
  "bugs": {
    "url": "https://github.com/musterd-io/whiteboard/issues"
  },
  "keywords": [
    "mcp",
    "whiteboard",
    "squig",
    "agents",
    "brainstorm",
    "claude-code",
    "codex",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "whiteboard": "./dist/mcp/index.js",
    "agent-whiteboard-mcp": "./dist/mcp/index.js",
    "agent-whiteboard-service": "./dist/service.js"
  },
  "files": [
    "dist",
    "vendor",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vendor:squig": "node scripts/vendor-squig.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@resvg/resvg-js": "2.6.2",
    "sharp": "0.35.5",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "8.1.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
